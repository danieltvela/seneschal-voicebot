# ==========================================================================
# Seneschal model services - environment configuration
# ==========================================================================
# Copy this file to .env and replace the placeholder paths with real host
# directories:
#
#   cp .env.example .env
#   chmod 600 .env
#   $EDITOR .env
#
# docker compose reads .env automatically from this directory.
# .env is git-ignored; never commit real paths, tokens or credentials.
# ==========================================================================

# --------------------------------------------------------------------------
# Hugging Face access token
# --------------------------------------------------------------------------
# Optional when all checkpoints are pre-downloaded locally or publicly
# accessible. Required for gated/private repositories.
HF_TOKEN=

# --------------------------------------------------------------------------
# Model directories (absolute paths on the Docker host)
# --------------------------------------------------------------------------
QWEN38_MODEL_DIR=/srv/seneschal/models/Qwen3.8-Flash-Next-FP4-Local
QWEN_ASR_MODEL_DIR=/srv/seneschal/models/Qwen3-ASR-1.7B
QWEN_TTS_MODEL_DIR=/srv/seneschal/models/Qwen3-TTS-12Hz-1.7B-Base
NEMOTRON_VL_MODEL_DIR=/srv/seneschal/models/NVIDIA-Nemotron-3.5-Super-VL-120B-A12B-NVFP4
NEMOTRON_VL_DRAFT_DIR=/srv/seneschal/models/NVIDIA-Nemotron-3.5-Super-VL-120B-A12B-NVFP4-LiLiCorr
NEMOTRON_ASR_MODEL_DIR=/srv/seneschal/models/nemotron-asr
MAGPIE_TTS_MODEL_DIR=/srv/seneschal/models/magpie-tts

# --------------------------------------------------------------------------
# Runtime caches (absolute paths on the Docker host)
# --------------------------------------------------------------------------
# HF_CACHE_DIR is usually the largest directory (hundreds of GB) and can
# point to a different volume than the smaller runtime caches.
HF_CACHE_DIR=/srv/seneschal/cache/huggingface
VLLM_CACHE_DIR=/srv/seneschal/cache/vllm
TRITON_CACHE_DIR=/srv/seneschal/cache/triton
FLASHINFER_CACHE_DIR=/srv/seneschal/cache/flashinfer
LIL_CACHE_DIR=/srv/seneschal/cache/lil
VLLM_OMNI_SPEAKERS_DIR=/srv/seneschal/cache/vllm-omni/speakers
VLLM_OMNI_VOICES_DIR=/srv/seneschal/cache/vllm-omni/precomputed-voices

# --------------------------------------------------------------------------
# GPU indices (as reported by nvidia-smi)
# --------------------------------------------------------------------------
# PRIMARY: Qwen LLM, Nemotron ASR, first rank of the NVIDIA TP=2 LLM.
# SECONDARY: Qwen ASR + TTS, Magpie TTS, second rank of the NVIDIA TP=2 LLM,
#            and the Nemotron TP=1 variant.
GPU_PRIMARY=0
GPU_SECONDARY=1

# --------------------------------------------------------------------------
# Optional image override
# --------------------------------------------------------------------------
# Local image built by magpie-tts/build-image.sh, or a registry copy.
MAGPIE_TTS_IMAGE=magpie-tts:latest

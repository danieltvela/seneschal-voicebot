    "@tauri-apps/cli": "^2.9.0",
    "@types/node": "^26.6.6",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}

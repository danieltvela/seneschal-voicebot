{
  "identifier": "default",
  "description": "Minimum capability for the desktop spike: UI events and the scoped Seneschal sidecar.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "process:default",
    "updater:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/seneschal",
          "sidecar": true,
          "args": true
        }
      ]
    }
  ]
}
